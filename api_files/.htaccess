# ==========================================================
# Creatah API Server Configuration (.htaccess)
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Direct rewrites when placed inside the /api/ folder
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^careers/?$ careers.php [L,QSA]
    RewriteRule ^users/?$ users.php [L,QSA]
    RewriteRule ^view-leads/?$ view-leads.php [L,QSA]

    # 2. Direct rewrites if placed in the domain root (above /api/)
    RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
    RewriteRule ^api/careers/?$ api/careers.php [L,QSA]
    RewriteRule ^api/users/?$ api/users.php [L,QSA]
    RewriteRule ^api/view-leads/?$ api/view-leads.php [L,QSA]

    # 3. Serve existing physical files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. General fallback: append .php if matching file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# Fallback router for any missing route
ErrorDocument 404 /api/index.php

# Enable CORS Headers for React Frontend, Vercel & Postman
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
</IfModule>
